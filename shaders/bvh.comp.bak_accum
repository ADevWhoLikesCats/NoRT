#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform image2D outImage;

struct Light { vec4 position; vec4 color; };

layout(std140, binding = 1) uniform CameraUBO {
    mat4 invViewProj;
    mat4 invModel;
    mat4 model;
    mat4 normalMatrix;
    vec4 camPosWorld;
    Light lights[3];
} cam;

struct Vtx { vec4 pos; vec4 albedo; vec4 mr; };
layout(std430, binding = 2) buffer Verts { Vtx verts[]; };

struct BVHNode {
    vec4 aabbMin;
    vec4 aabbMax;
    int  leftOrStart;
    int  rightOrCount;
};
layout(std430, binding = 3) buffer Nodes { BVHNode nodes[]; };

const float PI = 3.14159265359;
const int   MAX_BOUNCES = 2;     // primary ray = bounce 0, mirror reflection = bounce 1
const int   GI_SAMPLES  = 2;

// ---------- PBR ----------
float distributionGGX(vec3 N, vec3 H, float r) {
    float a = r*r; float a2 = a*a;
    float NdotH = max(dot(N,H),0.0);
    float NdotH2 = NdotH*NdotH;
    float d = (NdotH2*(a2-1.0)+1.0);
    d = PI*d*d;
    return a2 / max(d, 1e-6);
}
float geometrySchlickGGX(float NdotV, float r) {
    float rr = r+1.0; float k = (rr*rr)/8.0;
    return NdotV / (NdotV*(1.0-k)+k);
}
float geometrySmith(vec3 N, vec3 V, vec3 L, float r) {
    return geometrySchlickGGX(max(dot(N,V),0.0), r) *
           geometrySchlickGGX(max(dot(N,L),0.0), r);
}
vec3 fresnelSchlick(float c, vec3 F0) {
    return F0 + (1.0-F0)*pow(clamp(1.0-c,0.0,1.0),5.0);
}

// ---------- RNG ----------
uint hashSeed(uvec2 px) {
    uint h = px.x * 1973u + px.y * 9277u + 26699u;
    h = (h ^ 61u) ^ (h >> 16u);
    h = h * 9u; h = h ^ (h >> 4u); h = h * 0x27d4eb2du;
    return h ^ (h >> 15u);
}
float rand(inout uint s) {
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    w = (w >> 22u) ^ w;
    return float(w) / 4294967296.0;
}
vec3 randHemisphere(vec3 N, inout uint s) {
    float u1 = rand(s); float u2 = rand(s);
    float r  = sqrt(u1); float th = 2.0*PI*u2;
    vec3  lp = vec3(r*cos(th), r*sin(th), sqrt(max(0.0,1.0-u1)));
    vec3  up = abs(N.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3  T  = normalize(cross(up, N));
    vec3  B  = cross(N, T);
    return normalize(T*lp.x + B*lp.y + N*lp.z);
}

// ---------- Intersect ----------
bool hitTri(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out float t, out vec3 ng) {
    vec3 e1 = v1-v0, e2 = v2-v0;
    vec3 p  = cross(rd, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-8) return false;
    float invDet = 1.0/det;
    vec3 tv = ro-v0;
    float u = dot(tv, p)*invDet;
    if (u<0.0 || u>1.0) return false;
    vec3 q = cross(tv, e1);
    float v = dot(rd, q)*invDet;
    if (v<0.0 || u+v>1.0) return false;
    t = dot(e2, q)*invDet;
    ng = normalize(cross(e1, e2));
    return t > 1e-4;
}
bool slabTest(vec3 ro, vec3 invD, vec4 bmin, vec4 bmax, float tMax, out float tEnter) {
    vec3 t0 = (bmin.xyz - ro) * invD;
    vec3 t1 = (bmax.xyz - ro) * invD;
    vec3 tmin = min(t0,t1);
    vec3 tmax = max(t0,t1);
    float tn = max(max(tmin.x,tmin.y),max(tmin.z,0.0));
    float tf = min(min(tmax.x,tmax.y),min(tmax.z,tMax));
    tEnter = tn;
    return tf >= tn;
}

struct Hit { float t; int tri; vec3 ng; };

Hit traceClosest(vec3 ro, vec3 rd, float tMax) {
    Hit h; h.t = tMax; h.tri = -1; h.ng = vec3(0.0);
    vec3 invD = 1.0 / rd;
    int stack[32]; int sp = 0;
    stack[sp++] = 0;
    while (sp > 0) {
        int ni = stack[--sp];
        BVHNode n = nodes[ni];
        float tEnter;
        if (!slabTest(ro, invD, n.aabbMin, n.aabbMax, h.t, tEnter)) continue;
        if (n.rightOrCount < 0) {
            int start = n.leftOrStart;
            int count = -n.rightOrCount;
            for (int i = 0; i < count; ++i) {
                int t = start + i;
                vec3 v0 = verts[t*3+0].pos.xyz;
                vec3 v1 = verts[t*3+1].pos.xyz;
                vec3 v2 = verts[t*3+2].pos.xyz;
                float tt; vec3 ng;
                if (hitTri(ro, rd, v0, v1, v2, tt, ng) && tt < h.t) {
                    h.t = tt; h.tri = t; h.ng = ng;
                }
            }
        } else {
            stack[sp++] = n.rightOrCount;
            stack[sp++] = n.leftOrStart;
        }
    }
    return h;
}

bool traceOcclusion(vec3 ro, vec3 rd, float tMax) {
    vec3 invD = 1.0 / rd;
    int stack[32]; int sp = 0;
    stack[sp++] = 0;
    while (sp > 0) {
        int ni = stack[--sp];
        BVHNode n = nodes[ni];
        float tEnter;
        if (!slabTest(ro, invD, n.aabbMin, n.aabbMax, tMax, tEnter)) continue;
        if (n.rightOrCount < 0) {
            int start = n.leftOrStart;
            int count = -n.rightOrCount;
            for (int i = 0; i < count; ++i) {
                int t = start + i;
                vec3 v0 = verts[t*3+0].pos.xyz;
                vec3 v1 = verts[t*3+1].pos.xyz;
                vec3 v2 = verts[t*3+2].pos.xyz;
                float tt; vec3 ng;
                if (hitTri(ro, rd, v0, v1, v2, tt, ng) && tt < tMax) return true;
            }
        } else {
            stack[sp++] = n.rightOrCount;
            stack[sp++] = n.leftOrStart;
        }
    }
    return false;
}

// ---------- Shading ----------
// Evaluate direct lighting at a hit point. `N` face toward the incoming ray.
vec3 shadeDirect(vec3 P, vec3 N, vec3 V, vec3 albedo, float metal, float rough,
                 vec3 ro_model) {
    vec3 F0 = mix(vec3(0.04), albedo, metal);
    vec3 kD = (1.0 - fresnelSchlick(max(dot(N,V),0.0), F0)) * (1.0 - metal);

    vec3 Lo = vec3(0.0);
    for (int i = 0; i < 3; ++i) {
        vec3 Lw = normalize(cam.lights[i].position.xyz - P);
        float distToLight = length(cam.lights[i].position.xyz - P);

        // Shadow: any hit between P+eps*N and the light?
        vec3 Lw_transformed = normalize(Lw);
        vec4 LmodelH = cam.invModel * vec4(Lw_transformed, 0.0);
        vec3 Lm = LmodelH.xyz;
        bool occluded = traceOcclusion(ro_model + N * 1e-3, Lm, distToLight * 1.001);

        if (occluded) continue;

        vec3 H = normalize(V + Lw);
        float D = distributionGGX(N, H, rough);
        float G = geometrySmith(N, V, Lw, rough);
        vec3  F = fresnelSchlick(max(dot(H,V),0.0), F0);
        vec3  spec = (D*G*F) / (4.0*max(dot(N,V),0.0)*max(dot(N,Lw),0.0)+1e-6);
        float NdotL = max(dot(N,Lw),0.0);
        float atten = 1.0 / (distToLight * distToLight);
        Lo += (kD*albedo/PI + spec) * cam.lights[i].color.rgb * atten * NdotL;
    }
    return Lo;
}

vec3 shadeHit(vec3 ro_model, vec3 rd_model, Hit h, int depth, inout uint rng);

// Top-level: trace a ray, shade the hit. `depth` = bounces remaining.
vec3 traceAndShade(vec3 ro, vec3 rd, int depth, inout uint rng) {
    Hit h = traceClosest(ro, rd, 1e30);
    if (h.tri < 0) return vec3(0.03, 0.03, 0.05);
    return shadeHit(ro, rd, h, depth, rng);
}

vec3 shadeHit(vec3 ro_model, vec3 rd_model, Hit h, int depth, inout uint rng) {
    // P in model space; transform shading quantities to world.
    vec3 P_model = ro_model + rd_model * h.t;
    vec3 P_world = (cam.model * vec4(P_model, 1.0)).xyz;
    vec3 N_world = normalize(mat3(cam.normalMatrix) * h.ng);
    // Face normal toward incoming ray (in world).
    vec4 rdW4 = cam.model * vec4(rd_model, 0.0);
    vec3 rdW  = normalize(rdW4.xyz);
    if (dot(N_world, rdW) > 0.0) N_world = -N_world;
    vec3 V = -rdW;

    vec3  albedo = verts[h.tri*3].albedo.rgb;
    float metal  = verts[h.tri*3].mr.x;
    float rough  = clamp(verts[h.tri*3].mr.y, 0.04, 1.0);

    // Mirror.
    if (metal > 0.9 && rough < 0.1) {
        if (depth >= MAX_BOUNCES) return albedo * 0.1;
        vec3 reflDir = reflect(rdW, N_world);
        vec3 reflOrigin = P_world + N_world * 1e-3;
        vec4 rroH = cam.invModel * vec4(reflOrigin, 1.0);
        vec4 rrdH = cam.invModel * vec4(reflDir, 0.0);
        vec3 refl = traceAndShade(rroH.xyz, rrdH.xyz, depth+1, rng);
        return refl * vec3(0.95, 0.95, 0.98);
    }

    // Glass: dielectric refraction + Fresnel reflection.
    if (metal < 0.1 && rough < 0.05) {
        if (depth >= MAX_BOUNCES) return albedo * 0.5;

        // Determine entry vs exit (flip normal if exiting).
        bool entering = dot(rdW, N_world) < 0.0;
        vec3 Ng = N_world;
        float eta = entering ? (1.0 / 1.5) : 1.5;

        vec3 V   = -rdW;
        float cosI = clamp(dot(-V, Ng), 0.0, 1.0);
        float cosT2 = 1.0 - eta * eta * (1.0 - cosI * cosI);
        vec3 refrDir;
        bool totalInternal = cosT2 < 0.0;
        if (totalInternal) {
            refrDir = reflect(rdW, Ng);   // total internal reflection
        } else {
            refrDir = normalize(eta * rdW + (eta * cosI - sqrt(cosT2)) * Ng);
        }

        // Schlick Fresnel for dielectrics (F0 = 0.04 for glass at normal).
        float F0 = 0.04;
        float fresnel = F0 + (1.0 - F0) * pow(1.0 - cosI, 5.0);
        if (totalInternal) fresnel = 1.0;

        // Offset the ray origin slightly along the normal in the outgoing direction.
        vec3 offsetDir = entering ? Ng : -Ng;
        vec3 P_offset  = P_world + offsetDir * 1e-3;

        vec4 roH2 = cam.invModel * vec4(P_offset, 1.0);
        vec4 reflH = cam.invModel * vec4(reflect(rdW, Ng), 0.0);
        vec4 refrH = cam.invModel * vec4(refrDir,          0.0);

        vec3 reflCol = traceAndShade(roH2.xyz, reflH.xyz, depth+1, rng);
        vec3 refrCol = totalInternal
                     ? reflCol
                     : traceAndShade(roH2.xyz, refrH.xyz, depth+1, rng);

        // Glass tint: absorbed through the volume. Approximate with albedo.
        vec3 tint = albedo;
        return mix(refrCol * tint, reflCol, fresnel);
    }

    // Direct lighting (with shadows).
    vec3 direct = shadeDirect(P_world, N_world, V, albedo, metal, rough, P_model);

    // One-bounce diffuse GI.
    vec3 indirect = vec3(0.0);
    if (depth < MAX_BOUNCES) {
        vec3 N_model = normalize(mat3(cam.invModel) * N_world);
        for (int s = 0; s < GI_SAMPLES; ++s) {
            vec3 dir_model = randHemisphere(N_model, rng);
            // Slight offset to avoid self-intersection.
            vec3 origin = P_model + N_model * 1e-3;
            vec3 c = traceAndShade(origin, dir_model, depth+1, rng);
            indirect += c;
        }
        indirect /= float(GI_SAMPLES);
        indirect *= albedo;
    }

    return 0.03 * albedo + direct + indirect;
}

void main() {
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 ndc = vec2(
        (2.0 * (px.x + 0.5)) / float(size.x) - 1.0,
        (2.0 * (px.y + 0.5)) / float(size.y) - 1.0
    );

    vec4 farH = cam.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 farW = farH.xyz / farH.w;
    vec3 roW  = cam.camPosWorld.xyz;
    vec3 rdW  = normalize(farW - roW);

    // Move into model space for BVH intersection.
    vec4 roH = cam.invModel * vec4(roW, 1.0);
    vec4 rdH = cam.invModel * vec4(rdW, 0.0);
    vec3 ro  = roH.xyz;
    vec3 rd  = rdH.xyz;

    uint rng = hashSeed(uvec2(px));
    // Also seed with time so static frames still vary.
    // (Change this to a frame-uniform if you want deterministic results.)
    rng ^= uint(gl_NumWorkGroups.x * 1000003u);

    vec3 color = traceAndShade(ro, rd, 0, rng);
    color = color / (color + vec3(1.0));
    color = pow(color, vec3(1.0 / 2.2));
    imageStore(outImage, px, vec4(color, 1.0));
}
