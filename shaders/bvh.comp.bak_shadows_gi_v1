#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba8, binding = 0) uniform image2D outImage;

struct Light { vec4 position; vec4 color; };

layout(std140, binding = 1) uniform CameraUBO {
    mat4 invViewProj;
    mat4 invModel;
    mat4 model;
    mat4 normalMatrix;
    vec4 camPosWorld;
    Light lights[3];
} cam;

struct Vtx { vec4 pos; vec4 albedo; vec4 mr; };
layout(std430, binding = 2) buffer Verts { Vtx verts[]; };

struct BVHNode {
    vec4 aabbMin;     // xyz = min, w = unused
    vec4 aabbMax;     // xyz = max, w = unused
    int  leftOrStart;
    int  rightOrCount; // negative => leaf, abs = triangle count
};
layout(std430, binding = 3) buffer Nodes { BVHNode nodes[]; };

const float PI = 3.14159265359;

float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a  = roughness * roughness;
    float a2 = a * a;
    float NdotH  = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;
    return a2 / max(denom, 1e-6);
}

float geometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}

float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return geometrySchlickGGX(NdotV, roughness) * geometrySchlickGGX(NdotL, roughness);
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// ---------- RNG ----------
// PCG hash for per-pixel + per-sample seed. Stable, no state needed.
float rand(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word) / 4294967296.0;
}

vec3 randHemisphere(vec3 N, inout uint state) {
    // Cosine-weighted hemisphere around N (Malley's method).
    float u1 = rand(state);
    float u2 = rand(state);
    float r  = sqrt(u1);
    float th = 2.0 * PI * u2;
    vec3  lp = vec3(r * cos(th), r * sin(th), sqrt(max(0.0, 1.0 - u1)));
    // Build an orthonormal basis around N.
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);
    return normalize(T * lp.x + B * lp.y + N * lp.z);
}

bool hitTri(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out float t, out vec3 ng) {
    vec3 e1 = v1 - v0, e2 = v2 - v0;
    vec3 p  = cross(rd, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-8) return false;
    float invDet = 1.0 / det;
    vec3 tv = ro - v0;
    float u = dot(tv, p) * invDet;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(tv, e1);
    float v = dot(rd, q) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;
    t = dot(e2, q) * invDet;
    ng = normalize(cross(e1, e2));
    return t > 1e-4;
}

bool slabTest(vec3 ro, vec3 invD, vec4 bmin, vec4 bmax, float tMax, out float tEnter) {
    vec3 t0 = (bmin.xyz - ro) * invD;
    vec3 t1 = (bmax.xyz - ro) * invD;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    float tn = max(max(tmin.x, tmin.y), max(tmin.z, 0.0));
    float tf = min(min(tmax.x, tmax.y), min(tmax.z, tMax));
    tEnter = tn;
    return tf >= tn;
}

// Trace any triangle within `tMax`. Returns true if occluded.
bool traceOcclusion(vec3 ro, vec3 rd, float tMax) {
    vec3 invD = 1.0 / rd;
    int stack[32];
    int sp = 0;
    stack[sp++] = 0;

    while (sp > 0) {
        int ni = stack[--sp];
        BVHNode n = nodes[ni];
        float tEnter;
        if (!slabTest(ro, invD, n.aabbMin, n.aabbMax, tMax, tEnter)) continue;

        if (n.rightOrCount < 0) {
            int start = n.leftOrStart;
            int count = -n.rightOrCount;
            for (int i = 0; i < count; ++i) {
                int t = start + i;
                vec3 v0 = verts[t*3 + 0].pos.xyz;
                vec3 v1 = verts[t*3 + 1].pos.xyz;
                vec3 v2 = verts[t*3 + 2].pos.xyz;
                float tt; vec3 ng;
                if (hitTri(ro, rd, v0, v1, v2, tt, ng) && tt < tMax) return true;
            }
        } else {
            stack[sp++] = n.rightOrCount;
            stack[sp++] = n.leftOrStart;
        }
    }
    return false;
}

// Trace closest hit, return color via shared PBR evaluation. `depth` = bounces
// left (0 = direct light only, no GI).
vec3 shadeHit(vec3 ro_model, vec3 rd_model, float tHit, vec3 nHit_model,
              int depth, inout uint rngState);

void main() {
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 ndc = vec2(
        (2.0 * (px.x + 0.5)) / float(size.x) - 1.0,
        (2.0 * (px.y + 0.5)) / float(size.y) - 1.0
    );

    vec4 farH = cam.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 farW = farH.xyz / farH.w;
    vec3 roW  = cam.camPosWorld.xyz;
    vec3 rdW  = normalize(farW - roW);

    vec4 roH = cam.invModel * vec4(roW, 1.0);
    vec4 rdH = cam.invModel * vec4(rdW, 0.0);
    vec3 ro  = roH.xyz;
    vec3 rd  = rdH.xyz;
    vec3 invD = 1.0 / rd;

    float closestT = 1e30;
    int   closestI = -1;
    vec3  closestN = vec3(0.0);

    // Stack-based BVH traversal.
    int stack[32];
    int sp = 0;
    stack[sp++] = 0;   // root

    while (sp > 0) {
        int ni = stack[--sp];
        BVHNode n = nodes[ni];
        float tEnter;
        if (!slabTest(ro, invD, n.aabbMin, n.aabbMax, closestT, tEnter)) continue;

        if (n.rightOrCount < 0) {
            int start = n.leftOrStart;
            int count = -n.rightOrCount;
            for (int i = 0; i < count; ++i) {
                int t = start + i;
                vec3 v0 = verts[t*3 + 0].pos.xyz;
                vec3 v1 = verts[t*3 + 1].pos.xyz;
                vec3 v2 = verts[t*3 + 2].pos.xyz;
                float tt; vec3 ng;
                if (hitTri(ro, rd, v0, v1, v2, tt, ng) && tt < closestT) {
                    closestT = tt;
                    closestI = t;
                    closestN = ng;
                }
            }
        } else {
            stack[sp++] = n.rightOrCount;
            stack[sp++] = n.leftOrStart;
        }
    }

    vec3 color = vec3(0.05, 0.05, 0.05);

    if (closestI >= 0) {
        vec3 P_model = ro + rd * closestT;
        vec3 P_world = (cam.model * vec4(P_model, 1.0)).xyz;
        vec3 N_world = normalize(mat3(cam.normalMatrix) * closestN);

        // ---- Mirror check ----
        float mMetal = verts[closestI*3].mr.x;
        float mRough = verts[closestI*3].mr.y;
        if (mMetal > 0.9 && mRough < 0.1) {
            vec3 Nm = N_world;
            if (dot(Nm, rdW) > 0.0) Nm = -Nm;      // face incoming ray

            vec3 reflDir    = reflect(rdW, Nm);
            vec3 reflOrigin = P_world + Nm * 1e-3;

            vec4 rroH = cam.invModel * vec4(reflOrigin, 1.0);
            vec4 rrdH = cam.invModel * vec4(reflDir,    0.0);
            vec3 ro2  = rroH.xyz;
            vec3 rd2  = rrdH.xyz;
            vec3 invD2 = 1.0 / rd2;

            float rBestT = 1e30;
            int   rBestI = -1;
            vec3  rBestN = vec3(0.0);

            int stack2[32];
            int sp2 = 0;
            stack2[sp2++] = 0;

            while (sp2 > 0) {
                int ni = stack2[--sp2];
                BVHNode n = nodes[ni];
                float tEnter;
                if (!slabTest(ro2, invD2, n.aabbMin, n.aabbMax, rBestT, tEnter)) continue;

                if (n.rightOrCount < 0) {
                    int start = n.leftOrStart;
                    int count = -n.rightOrCount;
                    for (int i = 0; i < count; ++i) {
                        int t = start + i;
                        vec3 v0 = verts[t*3 + 0].pos.xyz;
                        vec3 v1 = verts[t*3 + 1].pos.xyz;
                        vec3 v2 = verts[t*3 + 2].pos.xyz;
                        float tt; vec3 ng;
                        if (hitTri(ro2, rd2, v0, v1, v2, tt, ng) && tt < rBestT) {
                            rBestT = tt;
                            rBestI = t;
                            rBestN = ng;
                        }
                    }
                } else {
                    stack2[sp2++] = n.rightOrCount;
                    stack2[sp2++] = n.leftOrStart;
                }
            }

            vec3 reflColor = vec3(0.03, 0.03, 0.05);
            if (rBestI >= 0) {
                vec3 rP_model = ro2 + rd2 * rBestT;
                vec3 rP_world = (cam.model * vec4(rP_model, 1.0)).xyz;
                vec3 rN       = normalize(mat3(cam.normalMatrix) * rBestN);
                if (dot(rN, rd2) > 0.0) rN = -rN;
                vec3 rV = -reflDir;

                vec3  rAlbedo = verts[rBestI*3].albedo.rgb;
                float rMetal  = verts[rBestI*3].mr.x;
                float rRough  = clamp(verts[rBestI*3].mr.y, 0.04, 1.0);
                vec3  rF0     = mix(vec3(0.04), rAlbedo, rMetal);
                vec3  rkD     = (1.0 - fresnelSchlick(max(dot(rN, rV), 0.0), rF0)) * (1.0 - rMetal);

                vec3 rLo = vec3(0.0);
                for (int i = 0; i < 3; ++i) {
                    vec3 L = normalize(cam.lights[i].position.xyz - rP_world);
                    vec3 H = normalize(rV + L);
                    float d = length(cam.lights[i].position.xyz - rP_world);
                    float a = 1.0 / (d * d);
                    float D = distributionGGX(rN, H, rRough);
                    float G = geometrySmith(rN, rV, L, rRough);
                    vec3  F = fresnelSchlick(max(dot(H, rV), 0.0), rF0);
                    vec3  spec = (D * G * F) / (4.0 * max(dot(rN, rV), 0.0) * max(dot(rN, L), 0.0) + 1e-6);
                    float NdotL = max(dot(rN, L), 0.0);
                    rLo += (rkD * rAlbedo / PI + spec) * cam.lights[i].color.rgb * a * NdotL;
                }
                reflColor = 0.03 * rAlbedo + rLo;
            }

            vec3 mirrorTint = vec3(0.95, 0.95, 0.98);
            vec3 mc = reflColor * mirrorTint;
            mc = mc / (mc + vec3(1.0));
            mc = pow(mc, vec3(1.0 / 2.2));
            imageStore(outImage, px, vec4(mc, 1.0));
            return;
        }
        // ---- End mirror branch ----

        vec3  N         = N_world;
        vec3  V         = normalize(cam.camPosWorld.xyz - P_world);
        vec3  albedo    = verts[closestI*3].albedo.rgb;
        float metallic  = verts[closestI*3].mr.x;
        float roughness = clamp(verts[closestI*3].mr.y, 0.04, 1.0);

        vec3 F0 = mix(vec3(0.04), albedo, metallic);
        vec3 kD = (1.0 - fresnelSchlick(max(dot(N, V), 0.0), F0)) * (1.0 - metallic);

        vec3 Lo = vec3(0.0);
        for (int i = 0; i < 3; ++i) {
            vec3  lightPos   = cam.lights[i].position.xyz;
            vec3  lightColor = cam.lights[i].color.rgb;

            vec3  L     = normalize(lightPos - P_world);
            vec3  H     = normalize(V + L);
            float dist  = length(lightPos - P_world);
            float atten = 1.0 / (dist * dist);

            float D = distributionGGX(N, H, roughness);
            float G = geometrySmith(N, V, L, roughness);
            vec3  F = fresnelSchlick(max(dot(H, V), 0.0), F0);

            vec3  numerator   = D * G * F;
            float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 1e-6;
            vec3  specular    = numerator / denominator;

            float NdotL = max(dot(N, L), 0.0);
            Lo += (kD * albedo / PI + specular) * lightColor * atten * NdotL;
        }

        vec3 ambient = 0.03 * albedo;
        color = ambient + Lo;
        color = color / (color + vec3(1.0));
        color = pow(color, vec3(1.0 / 2.2));
    }

    imageStore(outImage, px, vec4(color, 1.0));
}
